# Copy to .env and fill in. NEVER commit .env — the repo goes public.

# ClickHouse Cloud (Lane A) — from your provisioned service
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default

# Langfuse (Lane C) — our required integration. Self-hosted via Docker on localhost:3000.
# Generate keys in the Langfuse UI: Project Settings -> API Keys -> Create (pk-lf-... / sk-lf-...).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# LLM = AWS Bedrock (Lane C, narration only). Auth uses your configured AWS credential
# chain (aws cli / env vars / IAM role) — NO key goes in this file. Region + model default
# to backend/config.json (ap-southeast-2 / deepseek.v3.2); uncomment to override.
# AWS_REGION=ap-southeast-2
# BEDROCK_MODEL_ID=deepseek.v3.2
