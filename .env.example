# Copy to .env and fill in. NEVER commit .env — the repo goes public.
# This single .env feeds both the local venv run AND `docker compose up`.

# ClickHouse Cloud (Lane A) — from your provisioned service. External; never containerized.
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default

# Langfuse (Lane C). By default EVERYONE — every teammate's laptop and the deployed EC2 host —
# points at the team's ONE shared self-hosted Langfuse at https://traces.kangasys.com, not a
# fresh instance per machine. That used to be the bug: Langfuse packaged in docker-compose.yml
# meant every `docker compose up` minted an INDEPENDENT instance with its own trace database, so
# a trace recorded on one machine 404'd when read from another. Get a personal API key from
# https://traces.kangasys.com (log in — don't sign up, that creates a separate empty org — then
# Project Settings -> API Keys -> Create) and paste it below. LANGFUSE_HOST is left unset here on
# purpose: docker-compose.yml already defaults it to the shared host.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://traces.kangasys.com
#
# Prefer a fully local, offline Langfuse instead of the shared one? Run:
#   COMPOSE_PROFILES=self-hosted-langfuse docker compose up --build
# and uncomment ALL of these (leaving LANGFUSE_HOST commented would ingest into your local
# instance while trace links still opened the shared one's UI). LANGFUSE_PUBLIC_KEY/SECRET_KEY
# above still apply — any value works, since LANGFUSE_INIT_PROJECT_PUBLIC/SECRET_KEY in
# docker-compose.yml seeds your local instance with whatever you put there.
# LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_HOST=http://localhost:3000
# LANGFUSE_INIT_USER_PASSWORD=clickathon123    # seeded admin password, that profile only

# LLM = AWS Bedrock (Lane C, narration only). Region + model default to backend/config.json
# (ap-southeast-2 / deepseek.v3.2); uncomment to override.
# AWS_REGION=ap-southeast-2
# BEDROCK_MODEL_ID=deepseek.v3.2
#
# Auth uses the standard AWS credential chain. On a HOST venv run that's your ~/.aws (nothing
# to set here). For the BACKEND CONTAINER, ~/.aws is not visible — to enable narration in
# Docker, uncomment and paste your keys below (or leave blank: the pipeline still runs, it just
# skips the prose). Never commit these.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
