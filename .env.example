# Copy to .env and fill in. NEVER commit .env — the repo goes public.
# This single .env feeds both the local venv run AND `docker compose up`.

# ClickHouse Cloud (Lane A) — from your provisioned service. External; never containerized.
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default

# Langfuse (Lane C). In Docker these keys are HEADLESSLY SEEDED into the self-hosted Langfuse
# (see LANGFUSE_INIT_* in docker-compose.yml) AND read by the backend — so they must match.
# The dev values below work out of the box; change them together if you like.
#   - Docker:    LANGFUSE_HOST is overridden to http://langfuse-web:3000 by docker-compose.
#   - Host venv: leave LANGFUSE_HOST=http://localhost:3000 and create keys in the Langfuse UI.
LANGFUSE_PUBLIC_KEY=pk-lf-a0000000-0000-4000-8000-000000000001
LANGFUSE_SECRET_KEY=sk-lf-a0000000-0000-4000-8000-000000000002
LANGFUSE_HOST=http://localhost:3000
# Browser-facing host for trace LINKS. Docker sets this to http://localhost:3000 (compose) while
# LANGFUSE_HOST points at the internal langfuse-web service. On a host venv the two are the same,
# so you can leave this unset.
# LANGFUSE_PUBLIC_HOST=http://localhost:3000
# Password for the seeded Langfuse admin (email admin@clickathon.local), Docker only.
LANGFUSE_INIT_USER_PASSWORD=clickathon123

# LLM = AWS Bedrock (Lane C, narration only). Region + model default to backend/config.json
# (ap-southeast-2 / deepseek.v3.2); uncomment to override.
# AWS_REGION=ap-southeast-2
# BEDROCK_MODEL_ID=deepseek.v3.2
#
# Auth uses the standard AWS credential chain. On a HOST venv run that's your ~/.aws (nothing
# to set here). For the BACKEND CONTAINER, ~/.aws is not visible — to enable narration in
# Docker, uncomment and paste your keys below (or leave blank: the pipeline still runs, it just
# skips the prose). Never commit these.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
