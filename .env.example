# Copy to .env and fill in. NEVER commit .env — the repo goes public.

# ClickHouse Cloud (Lane A) — from your provisioned service
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default

# Langfuse (Lane C) — our required integration
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# LLM provider (Lane C) — narration only, a cheap model is fine
LLM_API_KEY=
LLM_MODEL=
